[Unit]
Description=RaidBench fail-closed Codex content and GEO/SEO publisher
Wants=network-online.target
After=network-online.target docker.service raidbench-source-scout.service
Requires=docker.service
StartLimitIntervalSec=2h
StartLimitBurst=8

[Service]
Type=oneshot
WorkingDirectory=/opt/raidbench-publisher
ExecStartPre=/usr/bin/install -d -o raidbench-agent -g raidbench-agent -m 0750 /opt/raidbench-publisher/workspace/.wrangler /opt/raidbench-publisher/workspace/.wrangler/tmp
ExecStartPre=/usr/bin/chown -R raidbench-agent:raidbench-agent /opt/raidbench-publisher/workspace
ExecStart=/usr/bin/docker compose -f /opt/raidbench-publisher/compose.yaml run --rm --no-deps content-agent
TimeoutStartSec=2h
Restart=on-failure
RestartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
