# Store the real file at /opt/raidbench/secrets/offsite-backup.env with mode 600.
RESTIC_REPOSITORY=s3:https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com/raidbench-backups
RESTIC_PASSWORD_FILE=/opt/raidbench/secrets/restic-password
AWS_ACCESS_KEY_ID=<R2_BUCKET_SCOPED_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_BUCKET_SCOPED_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=auto
