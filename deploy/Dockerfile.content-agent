FROM node:22-bookworm-slim

ARG RAIDBENCH_UID=999
ARG RAIDBENCH_GID=987

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/raidbench \
    CODEX_HOME=/home/raidbench/.codex \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates git python3 ripgrep sqlite3 \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global @openai/codex@0.153.0 wrangler@4.120.0 \
  && groupadd --gid "${RAIDBENCH_GID}" raidbench \
  && useradd --uid "${RAIDBENCH_UID}" --gid "${RAIDBENCH_GID}" --create-home --shell /usr/sbin/nologin raidbench \
  && mkdir -p /workspace /home/raidbench/.codex \
  && chown -R raidbench:raidbench /workspace /home/raidbench

WORKDIR /workspace
USER raidbench

CMD ["python3", "scripts/run_automatic_content_pipeline.py"]
