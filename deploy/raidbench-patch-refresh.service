[Unit]
Description=Revalidate one RaidBench patch-sensitive public page
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
User=raidbench-agent
Group=raidbench-agent
WorkingDirectory=/opt/raidbench-publisher/workspace
ExecStart=/usr/bin/python3 scripts/run_patch_refresh_check.py --registry content/patch-refresh-registry.json --database /opt/raidbench-agent/data/raidbench.local.db --state /opt/raidbench-agent/artifacts/content-automation/patch-refresh-state.json
TimeoutStartSec=5min
Restart=on-failure
RestartSec=20min
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/raidbench-agent/data /opt/raidbench-agent/artifacts
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target
