RAIDBENCH_AUTO_DEPLOY=1
RAIDBENCH_MAX_NEW_GUIDES_PER_HOUR=1
RAIDBENCH_MAX_NEW_GUIDES_PER_DAY=24
RAIDBENCH_AUTOMATION_MIN_SIGNAL_SCORE=7
RAIDBENCH_PREFERRED_GAME=
RAIDBENCH_PREFERRED_GAME_SCORE_BONUS=0

# Set only after Reddit grants commercial developer/data access for this use case.
RAIDBENCH_REDDIT_COMMERCIAL_PERMISSION_CONFIRMED=0

# One-time Feishu custom-bot setup. Keep both values only in the VPS secret file.
RAIDBENCH_FEISHU_WEBHOOK_URL=
RAIDBENCH_FEISHU_WEBHOOK_SECRET=

# Use a Cloudflare token scoped to Account / Cloudflare Pages / Edit for the RaidBench account.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-scoped-token
