          "id": "reuse",
          "label": "Useful across current loadouts",
          "weight": 25,
          "defaultA": 3,
          "defaultB": 5
        },
        {
          "id": "efficiency",
          "label": "Impact relative to resource cost",
          "weight": 25,
          "defaultA": 3,
          "defaultB": 4
        },
        {
          "id": "confidence",
          "label": "Current evidence confidence",
          "weight": 15,
          "defaultA": 4,
          "defaultB": 3
        }
      ],
      "assumptions": [
        "Scores are player judgments from 1 to 5, not hidden game statistics.",
        "Compare upgrades against the same target activity and account state.",
        "A close score means a controlled test is more useful than another ranking."
