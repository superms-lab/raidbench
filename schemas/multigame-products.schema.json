{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raidbench.com/schemas/multigame-products.schema.json",
  "type": "object",
  "required": ["schemaVersion", "asOf", "markets", "billingCurrency", "policy", "products"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "markets": { "type": "array", "items": { "enum": ["US", "CA"] }, "minItems": 2, "maxItems": 2 },
    "billingCurrency": { "const": "USD" },
    "policy": { "type": "object" },
    "products": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "gameId", "label", "credits", "deliveryClass", "status", "output", "requiredInputs", "evidenceRequirements", "qaRequirements", "activationGates", "noChargeReasons"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "gameId": { "type": "string" },
          "label": { "type": "string", "minLength": 12 },
          "credits": { "type": "integer", "minimum": 1, "maximum": 450 },
          "deliveryClass": { "enum": ["bounded_decision_review", "standard_source_review", "complex_match_review"] },
          "status": { "enum": ["hidden_pending_qa", "ready_live"] },
          "output": { "type": "string", "minLength": 60 },
          "requiredInputs": { "type": "array", "minItems": 4, "items": { "type": "string" } },
          "evidenceRequirements": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "qaRequirements": { "type": "array", "minItems": 4, "items": { "type": "string" } },
          "activationGates": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "noChargeReasons": { "type": "array", "minItems": 4, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
