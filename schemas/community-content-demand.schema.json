{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "target_title", "target_url", "published_at", "intent_zh", "topic"],
  "properties": {
    "status": { "type": "string", "enum": ["candidate", "none"] },
    "target_title": { "type": "string" },
    "target_url": { "type": "string" },
    "published_at": { "type": "string" },
    "intent_zh": { "type": "string" },
    "topic": {
      "type": "string",
      "enum": ["build_help", "boss_help", "loot_value", "currency_route", "progression", "patch"]
    }
  }
}
