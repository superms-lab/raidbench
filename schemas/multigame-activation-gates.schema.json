{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raidbench.com/schemas/multigame-activation-gates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "policy", "products"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDecision", "allGatesRequired", "repeatRunsDoNotIncreaseCaseCount", "shadowRunsChargeCredits", "manualOverrideCanBypassFailedGate"],
      "properties": {
        "defaultDecision": { "const": "hold" },
        "allGatesRequired": { "const": true },
        "repeatRunsDoNotIncreaseCaseCount": { "const": true },
        "shadowRunsChargeCredits": { "const": false },
        "manualOverrideCanBypassFailedGate": { "const": false }
      }
    },
    "products": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "minimumShadowCases", "minimumSupportedCases", "minimumSupportedQaPassRate", "minimumNoChargeCases", "minimumNoChargeAccuracy", "criticalDriftWindowCases", "maximumCriticalDrift", "maximumEvidenceAgeHours", "minimumInterReviewerCases", "minimumInterReviewerAgreementRate", "idempotencyRequired", "inAccountDeliveryRequired"],
        "properties": {
          "productId": { "type": "string" },
          "minimumShadowCases": { "type": "integer", "minimum": 15 },
          "minimumSupportedCases": { "type": "integer", "minimum": 10 },
          "minimumSupportedQaPassRate": { "type": "number", "minimum": 0.9, "maximum": 1 },
          "minimumNoChargeCases": { "type": "integer", "minimum": 3 },
          "minimumNoChargeAccuracy": { "type": "number", "minimum": 1, "maximum": 1 },
          "criticalDriftWindowCases": { "type": "integer", "minimum": 10 },
          "maximumCriticalDrift": { "type": "integer", "minimum": 0, "maximum": 0 },
          "maximumEvidenceAgeHours": { "type": "integer", "minimum": 1, "maximum": 72 },
          "minimumInterReviewerCases": { "type": "integer", "minimum": 0, "maximum": 25 },
          "minimumInterReviewerAgreementRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "idempotencyRequired": { "const": true },
          "inAccountDeliveryRequired": { "const": true }
        }
      }
    }
  }
}
