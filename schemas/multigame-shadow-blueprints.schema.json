{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raidbench.com/schemas/multigame-shadow-blueprints.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "policyVersion", "casesPerProduct", "blueprints"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "asOf": { "type": "string" },
    "policyVersion": { "type": "string" },
    "casesPerProduct": { "const": 3 },
    "blueprints": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["productId", "gameId", "gameVersion", "questionText", "inputs", "missingField", "evidenceSourceIds", "answerFocus"],
        "properties": {
          "productId": { "type": "string" },
          "gameId": { "type": "string" },
          "gameVersion": { "type": "string", "minLength": 8 },
          "questionText": { "type": "string", "minLength": 20 },
          "inputs": { "type": "object" },
          "missingField": { "type": "string" },
          "evidenceSourceIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answerFocus": { "type": "string", "minLength": 40 },
          "calculationFixture": {
            "type": "object",
            "required": ["toolId", "inputs", "assertions"],
            "properties": {
              "toolId": { "type": "string" },
              "inputs": { "type": "object" },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["calculationId", "label", "path", "expected", "tolerance"],
                  "properties": {
                    "calculationId": { "type": "string" },
                    "label": { "type": "string" },
                    "path": { "type": "string" },
                    "expected": { "type": "number" },
                    "tolerance": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
