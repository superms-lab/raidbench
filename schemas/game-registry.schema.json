{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raidbench.com/schemas/game-registry.schema.json",
  "title": "RaidBench game registry",
  "type": "object",
  "required": ["schemaVersion", "siteName", "games"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "siteName": { "const": "RaidBench" },
    "games": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "shortName",
          "code",
          "genre",
          "genreKey",
          "hubPath",
          "legacyPaths",
          "status",
          "indexable",
          "paidAnswers",
          "summary",
          "decisionAreas",
          "seedQuestions",
          "featuredLinks"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 2 },
          "shortName": { "type": "string", "minLength": 2 },
          "code": { "type": "string", "minLength": 2, "maxLength": 4 },
          "genre": { "type": "string", "minLength": 2 },
          "genreKey": { "enum": ["survival", "rpg", "extraction", "competitive"] },
          "hubPath": { "type": "string", "pattern": "^/games/[a-z0-9-]+/$" },
          "legacyPaths": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["live", "building"] },
          "indexable": { "type": "boolean" },
          "paidAnswers": { "enum": ["enabled", "content-only", "planned"] },
          "summary": { "type": "string", "minLength": 30 },
          "decisionAreas": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 3 }
          },
          "seedQuestions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 10 }
          },
          "featuredLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string", "minLength": 3 },
                "href": { "type": "string", "pattern": "^/" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
