{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "candidates"],
  "properties": {
    "status": { "type": "string", "enum": ["candidates", "none"] },
    "candidates": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "recipient", "source_url", "evidence_note", "subject", "text_body"],
        "properties": {
          "company": { "type": "string" },
          "recipient": { "type": "string" },
          "source_url": { "type": "string" },
          "evidence_note": { "type": "string" },
          "subject": { "type": "string" },
          "text_body": { "type": "string" }
        }
      }
    }
  }
}
