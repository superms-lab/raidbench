RAIDBENCH_MODE=production
RAIDBENCH_HOST=0.0.0.0
RAIDBENCH_PORT=8080
RAIDBENCH_DB_PATH=/data/raidbench.db
RAIDBENCH_RAID_DATA_PATH=/data/rust-raid-data.json
RAIDBENCH_CHECKOUT_ENABLED=0
PUBLIC_BASE_URL=https://raidbench.com
RAIDBENCH_SUPPORT_EMAIL=support@raidbench.com

# Required for the controlled Palworld Agent queue. Generate at least 32 random characters.
RAIDBENCH_JOB_QUEUE_DIR=/jobs
RAIDBENCH_JOB_SIGNING_SECRET=

# Automatic account recovery. Verify notify.raidbench.com with SMTP2GO before enabling these.
RAIDBENCH_EMAIL_PROVIDER=smtp2go
SMTP2GO_API_KEY=
RAIDBENCH_EMAIL_FROM=RaidBench <account@notify.raidbench.com>

# Optional legacy fallback. Do not configure both providers without setting RAIDBENCH_EMAIL_PROVIDER.
RESEND_API_KEY=

# Required before live checkout can turn on. Use the exact PayPal merchant identity.
RAIDBENCH_MERCHANT_LEGAL_NAME=
RAIDBENCH_MERCHANT_COUNTRY=
RAIDBENCH_TAX_POLICY_CONFIRMED=0

# Start with sandbox. Change to live only after a complete paid test and refund test.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Private owner alerts for completed, pending, denied, refunded, and reversed payments.
RAIDBENCH_PAYMENT_FEISHU_WEBHOOK_URL=
RAIDBENCH_PAYMENT_FEISHU_WEBHOOK_SECRET=
PUBLIC_PREVIEW_PORT=4290
